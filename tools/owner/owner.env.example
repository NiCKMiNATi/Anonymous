# Copy to "$HOME/Library/Application Support/AnonymousDev/owner.env" (outside the repository) and
# edit. Absolute paths only. Never commit the edited copy. KEY=VALUE lines; no shell syntax.
#
# The pinned llama-server binary (llama.cpp b11440) and the pinned Qwen3-4B-Q4_K_M model file:
RUNTIME_BIN=/absolute/path/to/llama-server
MODEL_PATH=/absolute/path/to/Qwen3-4B-Q4_K_M.gguf
# Optional (defaults shown). Both are loopback ports.
# LLAMA_PORT=18080
# APP_PORT=8000
